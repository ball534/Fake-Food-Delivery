{
  "name": "food-delivery-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fake food-delivery simulation game (Grab/Uber Eats look-alike).",
  "scripts": {
    "shops:index": "node ./scripts/build-shops-index.mjs",
    "predev": "npm run shops:index",
    "dev": "vite",
    "prebuild": "npm run shops:index",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.25.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
